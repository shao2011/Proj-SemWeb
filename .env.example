# EMBEDDINGS
COHERE_API_KEY=
VOYAGE_API_KEY=
JINA_API_KEY=

# OCR
DATALAB_API_KEY=

# LLM
# *_BASE_URL is the full prefix including the version segment when set:
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
OPENROUTER_API_KEY=
ORCAROUTER_API_KEY=
GROQ_API_KEY=

# VECTORDB
# Managed cluster: https://<cluster>.cloud.qdrant.io:6333 plus the key.
# Self-hosted: http://localhost:6333 and leave the key blank.
QDRANT_API_KEY=
QDRANT_URL=

# DATABASE
# Supabase: the pooler connection string, session mode (port 5432).
# postgresql://postgres.<ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
USERNAME=
PASSWORD=

# STORAGE
# R2 speaks the S3 API. Endpoint is https://<account-id>.r2.cloudflarestorage.com,
# region is always "auto", and the key pair comes from R2 > Manage API tokens.
# The token needs Object Read & Write; a read-only one answers 403 on upload.
# Set all four or none. Unset means media stays on local disk under MEDIA_ROOT,
# and a partial set makes the API refuse to start rather than silently write
# uploads to a disk the next deploy wipes.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# AUTH
# Comma-separated verified email addresses that are administrators before any
# database row exists. Also the floor: the API refuses to revoke or disable
# them, so the admin screen can never lock everybody out.
ADMIN_EMAILS=

# Without a Firebase service account (FIREBASE_SERVICE_ACCOUNT_PATH, or a
# *firebase-adminsdk-*.json in the repo root) Bearer tokens can't be verified
# and the API refuses to start. Set 1 only for local dev without auth; then
# any caller can act as any user.
AUTH_ALLOW_UNAUTHENTICATED=

# LOGGING
# INFO when unset. DEBUG writes full prompts and user document text to the
# logs, so only turn it on locally.
LOG_LEVEL=

# INGESTION LIMITS
# Per-file caps, checked before the expensive step. A file over one fails on
# its own with a message naming the limit; the rest of the batch carries on.
# Empty means the default in brackets.
# Rows x columns of one sheet [200000], the same summed over every sheet entry
# in a workbook [1000000], the area of one merged range [100000], and merged
# plus hyperlinked ranges in one sheet [10000].
INGEST_MAX_SHEET_CELLS=
INGEST_MAX_WORKBOOK_CELLS=
INGEST_MAX_MERGE_CELLS=
INGEST_MAX_RANGE_ELEMENTS=
# DOCX/XLSX/PPTX archives: unpacked bytes [209715200], entries [10000], and how
# far one part may expand over its compressed size [100].
INGEST_MAX_UNZIPPED_BYTES=
INGEST_MAX_ZIP_ENTRIES=
INGEST_MAX_ZIP_RATIO=
# PDF pages [500], and scanned pages sent to paid OCR [50].
INGEST_MAX_PDF_PAGES=
INGEST_MAX_OCR_PAGES=
# Pixels in one rendered page image [25000000]; bigger pages render at lower DPI.
INGEST_MAX_RENDER_PIXELS=
# Slides in one deck, checked before the paid conversion [300].
INGEST_MAX_SLIDES=
# Blocks one document may produce [200000]; every non-empty cell is one.
INGEST_MAX_BLOCKS=

# RATE LIMITS
# Sliding windows held in the API process (one worker). Over a limit the API
# answers 429 with Retry-After. Empty means the default in brackets; 0 turns
# that one limit off.
# Anonymous messages from all ids together per hour [200], and per client IP
# per hour [20] (IPv6 grouped by /64). The IP comes from X-Forwarded-For, which
# anyone reaching the API directly can forge, so the global cap is what
# actually bounds trial spend.
RATE_ANON_MESSAGES_GLOBAL_PER_HOUR=
RATE_ANON_MESSAGES_PER_IP_PER_HOUR=
# Per logged-in account: messages per minute [30], /query plus /answer per
# minute [60], uploaded files per hour [60]. A batch with more files than the
# hourly allowance gets 413 instead of a 429 it could never get past.
RATE_USER_MESSAGES_PER_MINUTE=
RATE_USER_RETRIEVAL_PER_MINUTE=
RATE_USER_UPLOADS_PER_HOUR=
