@prefix : <http://example.org/books#> .
@prefix schema: <https://schema.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/books> a owl:Ontology .

#################################################################
# Classes
#################################################################

:Book a owl:Class ;
    rdfs:subClassOf schema:Book ,
        [ a owl:Restriction ;
          owl:onProperty :hasEdition ;
          owl:someValuesFrom :BookEdition
        ] ,
        [ a owl:Restriction ;
          owl:onProperty :isWrittenBy ;
          owl:someValuesFrom :Author
        ] ;
    owl:disjointWith :BookEdition .

:BookEdition a owl:Class ;
    rdfs:subClassOf schema:Book ,
        [ a owl:Restriction ;
          owl:onProperty :isEditionOf ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass :Book
        ] .

:Person a owl:Class ;
    rdfs:subClassOf foaf:Person .

:Author a owl:Class ;
    rdfs:subClassOf :Person ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            :Person
            [ a owl:Restriction ;
              owl:onProperty :writes ;
              owl:someValuesFrom :Book
            ]
        )
    ] .

:Translator a owl:Class ;
    rdfs:subClassOf :Person ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            :Person
            [ a owl:Restriction ;
              owl:onProperty :translates ;
              owl:someValuesFrom :BookEdition
            ]
        )
    ] .

:Illustrator a owl:Class ;
    rdfs:subClassOf :Person .

:Editor a owl:Class ;
    rdfs:subClassOf :Person .

:Narrator a owl:Class ;
    rdfs:subClassOf :Person .

:Organization a owl:Class ;
    rdfs:subClassOf schema:Organization .

:Publisher a owl:Class ;
    rdfs:subClassOf :Organization .

:BookSeries a owl:Class ;
    rdfs:subClassOf schema:BookSeries .

:BookCategory a owl:Class .
:Character a owl:Class .

:Place a owl:Class ;
    rdfs:subClassOf schema:Place .

:Language a owl:Class ;
    rdfs:subClassOf schema:Language .

:BookFormat a owl:Class .

:Award a owl:Class .
:AwardRecognition a owl:Class .

:AwardWin a owl:Class ;
    rdfs:subClassOf :AwardRecognition .

:AwardNomination a owl:Class ;
    rdfs:subClassOf :AwardRecognition .

:AwardFinalistRecognition a owl:Class ;
    rdfs:subClassOf :AwardRecognition .

:SeriesBook a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            :Book
            [ a owl:Restriction ;
              owl:onProperty :isPartOfSeries ;
              owl:someValuesFrom :BookSeries
            ]
        )
    ] .

:TranslatedEdition a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            :BookEdition
            [ a owl:Restriction ;
              owl:onProperty :isTranslatedBy ;
              owl:someValuesFrom :Person
            ]
        )
    ] .

:IllustratedEdition a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            :BookEdition
            [ a owl:Restriction ;
              owl:onProperty :isIllustratedBy ;
              owl:someValuesFrom :Person
            ]
        )
    ] .

:AudiobookEdition a owl:Class ;
    rdfs:subClassOf :BookEdition , schema:Audiobook ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            :BookEdition
            [ a owl:Restriction ;
              owl:onProperty :hasFormat ;
              owl:hasValue :Audiobook
            ]
        )
    ] .

:AwardWinningBook a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            :Book
            [ a owl:Restriction ;
              owl:onProperty :hasAwardRecognition ;
              owl:someValuesFrom :AwardWin
            ]
        )
    ] .

#################################################################
# Object Properties
#################################################################

:hasEdition a owl:ObjectProperty ;
    rdfs:domain :Book ;
    rdfs:range :BookEdition ;
    rdfs:subPropertyOf schema:workExample ;
    owl:inverseOf :isEditionOf .

:isEditionOf a owl:ObjectProperty ;
    rdfs:domain :BookEdition ;
    rdfs:range :Book ;
    rdfs:subPropertyOf schema:exampleOfWork ;
    owl:inverseOf :hasEdition .

:isWrittenBy a owl:ObjectProperty ;
    rdfs:domain :Book ;
    rdfs:range :Person ;
    rdfs:subPropertyOf :hasContributor , schema:author ;
    owl:inverseOf :writes .

:writes a owl:ObjectProperty ;
    rdfs:domain :Person ;
    rdfs:range :Book ;
    owl:inverseOf :isWrittenBy .

:hasContributor a owl:ObjectProperty ;
    rdfs:domain :Book ;
    rdfs:range :Person ;
    rdfs:subPropertyOf dcterms:contributor .

:hasEditionContributor a owl:ObjectProperty ;
    rdfs:domain :BookEdition ;
    rdfs:range :Person ;
    rdfs:subPropertyOf dcterms:contributor .

:isTranslatedBy a owl:ObjectProperty ;
    rdfs:domain :BookEdition ;
    rdfs:range :Person ;
    rdfs:subPropertyOf :hasEditionContributor , schema:translator ;
    owl:inverseOf :translates .

:translates a owl:ObjectProperty ;
    rdfs:domain :Person ;
    rdfs:range :BookEdition ;
    owl:inverseOf :isTranslatedBy .

:isIllustratedBy a owl:ObjectProperty ;
    rdfs:domain :BookEdition ;
    rdfs:range :Person ;
    rdfs:subPropertyOf :hasEditionContributor , schema:illustrator .

:isEditedBy a owl:ObjectProperty ;
    rdfs:domain :BookEdition ;
    rdfs:range :Person ;
    rdfs:subPropertyOf :hasEditionContributor , schema:editor .

:isNarratedBy a owl:ObjectProperty ;
    rdfs:domain :BookEdition ;
    rdfs:range :Person ;
    rdfs:subPropertyOf :hasEditionContributor .

:isPartOfSeries a owl:ObjectProperty ;
    rdfs:domain :Book ;
    rdfs:range :BookSeries ;
    rdfs:subPropertyOf schema:isPartOf ;
    owl:inverseOf :hasBook .

:hasBook a owl:ObjectProperty ;
    rdfs:domain :BookSeries ;
    rdfs:range :Book ;
    rdfs:subPropertyOf schema:hasPart ;
    owl:inverseOf :isPartOfSeries .

:hasCategory a owl:ObjectProperty ;
    rdfs:domain :Book ;
    rdfs:range :BookCategory .

:hasCharacter a owl:ObjectProperty ;
    rdfs:domain :Book ;
    rdfs:range :Character ;
    owl:inverseOf :appearsIn .

:appearsIn a owl:ObjectProperty ;
    rdfs:domain :Character ;
    rdfs:range :Book ;
    owl:inverseOf :hasCharacter .

:isPublishedBy a owl:ObjectProperty ;
    rdfs:domain :BookEdition ;
    rdfs:range :Publisher ;
    rdfs:subPropertyOf schema:publisher ;
    owl:inverseOf :publishes .

:publishes a owl:ObjectProperty ;
    rdfs:domain :Publisher ;
    rdfs:range :BookEdition ;
    owl:inverseOf :isPublishedBy .

:isInLanguage a owl:ObjectProperty ;
    rdfs:domain :BookEdition ;
    rdfs:range :Language ;
    rdfs:subPropertyOf schema:inLanguage .

:setIn a owl:ObjectProperty ;
    rdfs:domain :Book ;
    rdfs:range :Place ;
    rdfs:subPropertyOf schema:contentLocation .

:hasFormat a owl:ObjectProperty ;
    rdfs:domain :BookEdition ;
    rdfs:range :BookFormat .

:hasAwardRecognition a owl:ObjectProperty ;
    rdfs:domain :Book ;
    rdfs:range :AwardRecognition .

:isRecognitionFor a owl:ObjectProperty ;
    rdfs:domain :AwardRecognition ;
    rdfs:range :Book .

:forAward a owl:ObjectProperty ;
    rdfs:domain :AwardRecognition ;
    rdfs:range :Award .

#################################################################
# Datatype Properties
#################################################################

:bookId a owl:DatatypeProperty ;
    rdfs:domain :BookEdition ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:identifier .

:title a owl:DatatypeProperty ;
    rdfs:domain :Book ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:title .

:description a owl:DatatypeProperty ;
    rdfs:domain :Book ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:description .

:isbn a owl:DatatypeProperty ;
    rdfs:domain :BookEdition ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf schema:isbn .

:editionName a owl:DatatypeProperty ;
    rdfs:domain :BookEdition ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf schema:bookEdition .

:pageCount a owl:DatatypeProperty ;
    rdfs:domain :BookEdition ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:subPropertyOf schema:numberOfPages .

:publishDate a owl:DatatypeProperty ;
    rdfs:domain :BookEdition ;
    rdfs:range xsd:date ;
    rdfs:subPropertyOf schema:datePublished .

:firstPublishDate a owl:DatatypeProperty ;
    rdfs:domain :Book ;
    rdfs:range xsd:date ;
    rdfs:subPropertyOf schema:datePublished .

:rating a owl:DatatypeProperty ;
    rdfs:domain :Book ;
    rdfs:range xsd:decimal .

:numRatings a owl:DatatypeProperty ;
    rdfs:domain :Book ;
    rdfs:range xsd:nonNegativeInteger .

:likedPercent a owl:DatatypeProperty ;
    rdfs:domain :Book ;
    rdfs:range xsd:decimal .

:coverImage a owl:DatatypeProperty ;
    rdfs:domain :BookEdition ;
    rdfs:range xsd:anyURI .

:bbeScore a owl:DatatypeProperty ;
    rdfs:domain :Book ;
    rdfs:range xsd:decimal .

:bbeVotes a owl:DatatypeProperty ;
    rdfs:domain :Book ;
    rdfs:range xsd:nonNegativeInteger .

:price a owl:DatatypeProperty ;
    rdfs:domain :BookEdition ;
    rdfs:range xsd:decimal .

:seriesPosition a owl:DatatypeProperty ;
    rdfs:domain :Book ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf schema:position .

:awardYear a owl:DatatypeProperty ;
    rdfs:domain :AwardRecognition ;
    rdfs:range xsd:gYear .

:fiveStarRatings a owl:DatatypeProperty ;
    rdfs:domain :Book ;
    rdfs:range xsd:nonNegativeInteger .

:fourStarRatings a owl:DatatypeProperty ;
    rdfs:domain :Book ;
    rdfs:range xsd:nonNegativeInteger .

:threeStarRatings a owl:DatatypeProperty ;
    rdfs:domain :Book ;
    rdfs:range xsd:nonNegativeInteger .

:twoStarRatings a owl:DatatypeProperty ;
    rdfs:domain :Book ;
    rdfs:range xsd:nonNegativeInteger .

:oneStarRatings a owl:DatatypeProperty ;
    rdfs:domain :Book ;
    rdfs:range xsd:nonNegativeInteger .

#################################################################
# Required ontology individual
#################################################################

:Audiobook a owl:NamedIndividual , :BookFormat .
